# ===================================================
# CONFIGURAÇÃO DE AMBIENTE - DvD (100% GRÁTIS)
# ===================================================

# 1. BANCO DE DADOS NEON POSTGRESQL (100% Grátis)
# Insira sua URL de conexão do Neon (apague em produção se for usar as vars do Render)
DATABASE_URL=postgresql://neondb_owner:***SUA_SENHA_AQUI***@ep-***.us-east-2.aws.neon.tech/neondb?sslmode=require

# 2. SEGURANÇA JWT
# Gere uma string aleatória longa. Em produção, se não informada, uma nova chave será gerada a cada inicialização.
JWT_SECRET=sua-chave-secreta-longa-e-aleatoria-aqui

# 3. PORTA DO SERVIDOR (No Render, o Render define PORT automaticamente)
PORT=3001

# 4. RENDER ANTI-SLEEP (Self-Ping para nunca dormir)
APP_URL=https://meu-discord.onrender.com

# 5. LGPD E PRIVACIDADE
PRIVACY_CONTACT=dpo@seudominio.com

# 6. SERVIDORES STUN/TURN (WebRTC P2P) - Opcional
# Melhora chamadas de voz e esconde o IP dos usuários
# TURN_URLS=turn:global.turn.twilio.com:3478
# TURN_USERNAME=xxx
# TURN_CREDENTIAL=xxx

# 7. CORS
# ALLOWED_ORIGINS=https://meu-discord.onrender.com,http://localhost:5173
