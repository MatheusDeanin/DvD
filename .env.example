# ===================================================
# CONFIGURAÇÃO DE AMBIENTE - DISCORD CLONE 100% GRÁTIS
# ===================================================

# 1. BANCO DE DADOS NEON POSTGRESQL (100% Grátis)
# Crie uma conta gratuita em https://neon.tech
# Crie um projeto e copie a string de conexão:
DATABASE_URL=postgresql://neondb_owner:sua_senha@ep-exemplo.us-east-2.aws.neon.tech/neondb?sslmode=require

# 2. SEGURANÇA JWT
JWT_SECRET=sua_chave_secreta_super_segura_aqui_123456

# 3. PORTA DO SERVIDOR (No Render, o Render define PORT automaticamente)
PORT=3001

# 4. RENDER ANTI-SLEEP (Self-Ping para nunca dormir)
# No Render, o próprio Render define RENDER_EXTERNAL_URL automaticamente!
# Mas você também pode definir explicitamente sua URL do Render:
APP_URL=https://meu-discord.onrender.com
